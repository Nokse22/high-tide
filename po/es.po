# machine-translated
#: data/ui/preferences.blp:53
msgid "Sample Rate"
msgstr "Frecuencia de muestreo"

# machine-translated
#: data/ui/preferences.blp:54
msgid ""
"Your computer normally plays everything at one rate, usually 48 kHz, and "
"converts each song to it. Hi-res songs only reach your sound card at their "
"own rate through the ALSA output above, which mutes everything else while "
"playing, or if your system is set up to switch rates. Some sound cards then "
"pop when the next song has a different rate."
msgstr ""
"Tu computadora normalmente reproduce todo a una sola frecuencia, por lo "
"general 48 kHz, y convierte cada canción a ella. Las canciones Hi-Res solo "
"llegan a tu tarjeta de sonido a su propia frecuencia a través de la salida "
"ALSA de arriba, que silencia todo lo demás durante la reproducción, o si tu "
"sistema está configurado para cambiar de frecuencia. Algunas tarjetas de "
"sonido producen entonces un chasquido cuando la siguiente canción tiene otra "
"frecuencia."

# machine-translated
#: data/ui/preferences.blp:57
msgid "Play Songs at Their Own Rate"
msgstr "Reproducir las canciones a su propia frecuencia"

# machine-translated
#: data/ui/preferences.blp:67
msgid "Convert Songs To"
msgstr "Convertir las canciones a"

# machine-translated
#: data/ui/preferences.blp:68
msgid "Pick a rate to stop the pop"
msgstr "Elige una frecuencia para evitar el chasquido"

# machine-translated
#: data/ui/preferences.blp:71
msgid "Don't Convert"
msgstr "No convertir"

# machine-translated
#: data/ui/preferences.blp:84
