#: data/ui/login.blp:32
msgid ""
"Scan the code with your phone, or open the link where you're signed in to "
"TIDAL, and approve High Tide."
msgstr ""
"Escanea el código con tu teléfono, o abre el enlace donde hayas iniciado "
"sesión en TIDAL, y aprueba a High Tide."

