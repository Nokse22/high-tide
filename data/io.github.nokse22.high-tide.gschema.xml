<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="tidal">
	<schema id="io.github.nokse22.high-tide" path="/io/github/nokse22/tidal/">
	  <key name="window-width" type="i">
      <default>1000</default>
    </key>
    <key name="window-height" type="i">
      <default>800</default>
    </key>
	  <key name="prefer-clean-versions" type="b">
      <default>false</default>
    </key>
	  <key name="quality" type="i">
      <default>2</default>
    </key>
	  <key name="last-playing-index" type="i">
      <default>-1</default>
    </key>
	  <key name="last-playing-thing-id" type="s">
      <default>''</default>
    </key>
	  <key name="last-playing-thing-type" type="s">
      <default>''</default>
    </key>
	  <key name="shuffle" type="b">
      <default>false</default>
      <summary>Whether shuffle is on</summary>
    </key>
	  <key name="last-playing-shuffle-order" type="as">
      <default>[]</default>
      <summary>The songs still to play, in their shuffled order</summary>
    </key>
	  <key name="last-playing-track-id" type="s">
      <default>''</default>
    </key>
	  <key name="queue-songs" type="as">
      <default>[]</default>
      <summary>The queue, each as "1 if it's the song playing, tab, track id, tab, type of what it was queued from, tab, its id"</summary>
    </key>
	  <key name="played-songs" type="as">
      <default>[]</default>
      <summary>The history: played songs, oldest first, each as "track id, tab, type of what it was played from, tab, its id"</summary>
    </key>
	  <key name="last-volume" type="i">
      <default>10</default>
    </key>
	  <key name="volume" type="d">
      <default>1.0</default>
    </key>
	  <key name="repeat" type="i">
      <default>0</default>
    </key>
	  <key name="last-tab" type="s">
      <choices>
        <choice value="home"/>
        <choice value="explore"/>
        <choice value="collection"/>
      </choices>
      <default>"home"</default>
      <summary>The tab (Home, Explore or Collection) to open at start, the last one used</summary>
    </key>
	  <key name="preferred-sink" type="i">
	    <range min="0" max="6"/>
      <default>0</default>
    </key>
	  <key name="queue-panel-open" type="b">
      <default>false</default>
    </key>
	  <key name="sort-playlists" type="s">
      <choices>
        <choice value="created"/>
        <choice value="updated"/>
        <choice value="name"/>
      </choices>
      <default>"created"</default>
    </key>
	  <key name="sort-playlists-reversed" type="b">
      <default>false</default>
    </key>
	  <key name="sort-albums" type="s">
      <choices>
        <choice value="date"/>
        <choice value="name"/>
        <choice value="artist"/>
        <choice value="release"/>
      </choices>
      <default>"name"</default>
    </key>
	  <key name="sort-albums-reversed" type="b">
      <default>false</default>
    </key>
	  <key name="sort-tracks" type="s">
      <choices>
        <choice value="date"/>
        <choice value="name"/>
        <choice value="artist"/>
        <choice value="album"/>
        <choice value="length"/>
      </choices>
      <default>"date"</default>
    </key>
	  <key name="sort-tracks-reversed" type="b">
      <default>false</default>
    </key>
	  <key name="sort-artists" type="s">
      <choices>
        <choice value="date"/>
        <choice value="name"/>
      </choices>
      <default>"name"</default>
    </key>
	  <key name="sort-artists-reversed" type="b">
      <default>false</default>
    </key>
	  <key name="sort-mixes" type="s">
      <choices>
        <choice value="date"/>
        <choice value="name"/>
        <choice value="type"/>
      </choices>
      <default>"date"</default>
    </key>
	  <key name="sort-mixes-reversed" type="b">
      <default>false</default>
    </key>
	  <key name="autoplay" type="b">
      <default>false</default>
    </key>
	  <key name="run-background" type="b">
      <default>false</default>
    </key>
	  <key name="normalize" type="b">
      <default>false</default>
    </key>
	  <key name="output-rate" type="i">
      <default>0</default>
      <summary>Sample rate songs are converted to before the output ("Convert Songs To"), 0 for no conversion</summary>
    </key>
	  <key name="quadratic-volume" type="b">
      <default>false</default>
    </key>
	  <key name="app-id-change-understood" type="b">
      <default>false</default>
    </key>
	  <key name="video-covers" type="b">
      <default>true</default>
    </key>
	  <key name="background-blur" type="b">
      <default>false</default>
      <summary>Make the window see-through with the desktop blurred behind it</summary>
    </key>
	  <key name="background-see-through" type="d">
      <range min="0.1" max="0.9"/>
      <default>0.28</default>
      <summary>How see-through the window is with background-blur on</summary>
    </key>
	  <key name="discord-rpc" type="b">
      <default>true</default>
    </key>
	  <key name="hide-ai-music" type="b">
      <default>false</default>
    </key>
	  <key name="home-my-tracks" type="b">
      <default>false</default>
      <summary>Always show a My Tracks button on Home</summary>
    </key>
	  <key name="home-hidden-rows" type="a{ss}">
      <default>{}</default>
      <summary>Home rows turned off in Customize Home</summary>
      <description>TIDAL's id of each hidden row, with its title when it was hidden</description>
    </key>
	  <key name="alsa-device" type="s">
      <default>'default'</default>
    </key>
	  <key name="jack-connect" type="s">
      <default>''</default>
      <summary>Where the JACK output connects to</summary>
      <description>A JACK client's name, '' for the sound card or '@nothing' to leave connecting to a patchbay</description>
    </key>
	</schema>
</schemalist>
