using Gtk 4.0;
using Adw 1;

Adw.PreferencesDialog _preference_window {
  Adw.PreferencesPage {
    title: _("General");
    icon-name: "applications-system-symbolic";

    Adw.PreferencesGroup {
      title: _("Audio");
      Adw.ComboRow _quality_row {
        model: StringList {
          strings [
            _("Low 96k"),
            _("High 320k"),
            _("Lossless"),
            _("Hi-res Lossless"),
          ]
        };

        title: _("Quality");
      }
      Adw.ComboRow _sink_row {
        model: StringList {
          strings [
            _("Automatic"),
            "PulseAudio",
            "ALSA",
            "Jack",
            "OSS",
          ]
        };

        title: _("Preferred Audio Sink");
      }
      Adw.ComboRow _alsa_device_row{
        title: _("ALSA Device");
        subtitle: _("Device used for exclusive ALSA access");
      }
      Adw.SwitchRow _normalize_row {
        title: _("Normalize volume");
      }
    }

    Adw.PreferencesGroup {
      title: _("Content");
      Adw.SwitchRow _hide_ai_row {
        title: _("Hide AI-generated music");
        subtitle: _("Leave AI-generated tracks out of lists and skip them during playback. TIDAL does not expose its AI content preference through the API, so this setting is stored locally.");
      }
    }

    Adw.PreferencesGroup {
      title: _("App");
      Adw.SwitchRow _background_row {
        title: _("Run in the background");
      }
      Adw.SwitchRow _quadratic_volume_row {
        title: _("Use quadratic volume control");
      }
      Adw.SwitchRow _video_cover_row {
        title: _("Display animated covers");
      }
      Adw.SwitchRow _discord_rpc_row {
        title: _("Enable Discord Rich Presence");
      }
      Adw.SwitchRow _prefer_clean_row {
        title: _("Prefer clean versions");
        subtitle: _("On artist pages, show the clean version of albums that also have an explicit one");
      }
    }
    Adw.PreferencesGroup {
      title: _("Last.fm Scrobbling");
      description: _("Send the songs you play to your Last.fm profile.");

      Adw.ActionRow _lastfm_status_row {
        title: _("Not connected");

        [suffix]
        Button _lastfm_connect_button {
          label: _("Connect");
          valign: center;

          styles [
            "suggested-action",
          ]
        }

        [suffix]
        Button _lastfm_disconnect_button {
          label: _("Disconnect");
          valign: center;
          visible: false;
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("ListenBrainz");
      description: _("Send the songs you play to your ListenBrainz profile.");

      Adw.PasswordEntryRow _listenbrainz_token_row {
        title: _("User Token");
        show-apply-button: true;
      }

      Adw.ActionRow _listenbrainz_token_help_row {
        title: _("Get Your User Token");
        subtitle: "listenbrainz.org/settings";
        activatable: true;

        [suffix]
        Image {
          icon-name: "adw-external-link-symbolic";
        }
      }

      Adw.ActionRow _listenbrainz_status_row {
        title: _("Connected");
        visible: false;

        [suffix]
        Button _listenbrainz_disconnect_button {
          label: _("Disconnect");
          valign: center;
          visible: false;
        }
      }
    }
  }

  Adw.PreferencesPage {
    title: _("Blocked");
    icon-name: "action-unavailable-symbolic";

    Adw.PreferencesGroup {
      description: _("Blocked artists and tracks are left out of your mixes and radio.");
    }

    Adw.PreferencesGroup _blocked_artists_group {
      title: _("Artists");
    }

    Adw.PreferencesGroup _blocked_tracks_group {
      title: _("Tracks");
    }

    Adw.PreferencesGroup _blocked_videos_group {
      title: _("Videos");
    }
  }
}
