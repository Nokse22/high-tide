using Gtk 4.0;
using Adw 1;

template $HTCarouselWidget: Box {
  margin-bottom: 12;
  margin-end: 12;
  margin-start: 12;
  orientation: vertical;
  overflow: hidden;

  Box {
    margin-bottom: 6;
    margin-top: 12;

    // What a row like "Because you listened to" is about, see set_context()
    Button context_button {
      visible: false;
      hexpand: true;
      halign: start;

      styles [
        "flat",
      ]

      child: Box {
        spacing: 12;

        Image context_image {
          pixel-size: 48;
          overflow: hidden;
          icon-name: 'emblem-music-symbolic';

          styles [
            "small-image",
          ]
        }

        Box {
          orientation: vertical;
          valign: center;

          Label context_label {
            xalign: 0;
            ellipsize: end;

            styles [
              "caption",
              "dim-label",
            ]
          }

          Label context_title_label {
            xalign: 0;
            ellipsize: end;

            styles [
              "title-3",
            ]
          }
        }
      };
    }

    Label title_label {
      styles [
        "title-3",
      ]

      ellipsize: end;
      hexpand: true;
      margin-start: 6;
      xalign: -0.0;
    }

    Button more_button {
      label: _("View All");

      styles [
        "small-pill",
      ]

      halign: end;
      hexpand: true;
      margin-end: 12;
      valign: center;
      visible: false;
    }

    Button prev_button {
      styles [
        "circular",
      ]

      halign: end;
      icon-name: 'go-previous-symbolic';
      tooltip-text: _("Previous");
      margin-start: 6;
      valign: center;
      sensitive: false;
    }

    Button next_button {
      styles [
        "circular",
      ]

      halign: end;
      icon-name: 'go-next-symbolic';
      tooltip-text: _("Next");
      margin-start: 6;
      valign: center;
      sensitive: false;
    }
  }

  ScrolledWindow carousel_scrolled_window {
    hscrollbar-policy: external;
    vscrollbar-policy: never;
    hexpand: true;
    overflow: visible;

    Box cards_box {
      orientation: horizontal;
      spacing: 6;
      halign: start;
    }
  }
}
