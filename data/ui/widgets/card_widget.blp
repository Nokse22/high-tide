using Gtk 4.0;
using Adw 1;

template $HTCardWidget: Adw.BreakpointBin {
  styles [
    "card-bg",
  ]

  hexpand: true;
  halign: center;
  width-request: 167;
  height-request: 214;

  child: Box {
    margin-bottom: 6;
    margin-end: 6;
    margin-start: 6;
    margin-top: 6;
    orientation: vertical;
    spacing: 3;

    GestureClick click_gesture {}

    EventControllerMotion motion_controller {}

    Overlay {
      halign: center;

      Image image {
        halign: center;
        icon-name: 'emblem-music-symbolic';
        pixel-size: 155;
        valign: center;
        overflow: hidden;

        styles [
          "card-image",
        ]
      }

      [overlay]
      Revealer play_revealer {
        halign: end;
        valign: end;
        margin-end: 8;
        margin-bottom: 8;
        transition-type: crossfade;

        Button play_button {
          icon-name: 'media-playback-start-symbolic';
          tooltip-text: _("Play");

          styles [
            "circular",
            "card-play-button",
          ]
        }
      }
    }

    Box {
      spacing: 6;

      Label title_label {
        styles [
          "title-4",
        ]

        max-width-chars: 13;
        xalign: 0;
        ellipsize: end;
        hexpand: true;
      }

      Label ai_label {
        label: "AI";

        styles [
          "explicit-label",
        ]

        visible: false;
        valign: center;
        tooltip-text: _("AI-generated");
      }
    }

    Box details_box {
      Label detail_label {
        styles [
          "dim-label",
        ]

        max-width-chars: 16;
        xalign: 0;
        ellipsize: end;
      }

      $HTLinkLabelWidget track_artist_label {
        ellipsize: 'end';
        max-width-chars: 16;
        xalign: '0';
      }
    }
  };
}
