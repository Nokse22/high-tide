using Gtk 4.0;
using Adw 1;

template $HTQueueWidget: Box {
  orientation: vertical;
  spacing: 12;

  Adw.ToolbarView {
    content: ScrolledWindow scrolled_window {
      vexpand: true;

      styles [
        "undershoot-bottom",
      ]

      Box {
        orientation: vertical;
        spacing: 12;
        margin-bottom: 12;
        margin-top: 12;
        margin-start: 12;
        margin-end: 12;

        Box played_songs_box {
          orientation: vertical;
          spacing: 6;

          Label {
            styles [
              "title-4",
            ]

            ellipsize: end;
            hexpand: true;
            xalign: 0.0;
            label: _("Played Songs");
          }

          ListBox played_songs_list {
            row-activated => $on_played_song_activated();

            styles [
              "tracks-list-box",
            ]
          }
        }

        // Between what was played and what comes next
        Box playing_song_box {
          orientation: vertical;
          spacing: 6;
          visible: false;

          Label {
            styles [
              "title-4",
            ]

            ellipsize: end;
            hexpand: true;
            xalign: 0.0;
            label: _("Now Playing");
          }

          ListBox playing_song_list {
            selection-mode: none;

            styles [
              "tracks-list-box",
            ]
          }
        }

        Box queued_songs_box {
          orientation: vertical;
          spacing: 6;

          Box {
            Label {
              styles [
                "title-4",
              ]

              ellipsize: end;
              hexpand: true;
              xalign: 0.0;
              label: _("Queue");
            }

            Button clear_queue_button {
              label: _("Clear");
              tooltip-text: _("Remove all songs from the queue");
              valign: center;
              clicked => $on_clear_queue_clicked();

              styles [
                "flat",
              ]
            }
          }

          ListBox queued_songs_list {
            row-activated => $on_queued_song_activated();

            styles [
              "tracks-list-box",
            ]
          }
        }

        Box next_songs_box {
          orientation: vertical;
          spacing: 6;

          Box {
            Label {
              styles [
                "title-4",
              ]

              ellipsize: end;
              hexpand: true;
              xalign: 0.0;
              label: _("Next Songs");
            }

            Button clear_next_songs_button {
              label: _("Clear");
              tooltip-text: _("Remove all next songs");
              valign: center;
              clicked => $on_clear_next_songs_clicked();

              styles [
                "flat",
              ]
            }
          }

          ListBox next_songs_list {
            row-activated => $on_next_song_activated();

            styles [
              "tracks-list-box",
            ]
          }
        }
      }
    };
  }
}
