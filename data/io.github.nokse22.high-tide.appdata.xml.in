<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop">
  <id>io.github.nokse22.high-tide</id>
  <provides>
    <id>io.github.nokse22.HighTide</id>
  </provides>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>High Tide</name>
  <summary>TIDAL client</summary>
  <description>
    <p>Third party unofficial TIDAL music client. Listen to your favorite music from your desktop or mobile Linux device at the highest quality.</p>
  </description>
  <content_rating type="oars-1.1">
    <content_attribute id="language-profanity">intense</content_attribute>
    <content_attribute id="language-humor">moderate</content_attribute>
    <content_attribute id="sex-themes">moderate</content_attribute>
    <content_attribute id="drugs-alcohol">moderate</content_attribute>
    <content_attribute id="violence-realistic">mild</content_attribute>
  </content_rating>

  <developer id="io.github.nokse22">
    <name translate="no">The High Tide Contributors</name>
  </developer>

  <branding>
    <color type="primary" scheme_preference="light">#8FEAEB</color>
    <color type="primary" scheme_preference="dark">#24C9CB</color>
  </branding>

  <launchable type="desktop-id">io.github.nokse22.high-tide.desktop</launchable>

  <url type="homepage">https://github.com/Nokse22/high-tide</url>
  <url type="bugtracker">https://github.com/Nokse22/high-tide/issues</url>
  <url type="vcs-browser">https://github.com/Nokse22/high-tide</url>
  <url type="translate">https://github.com/Nokse22/high-tide/tree/master/po</url>
  <url type="donation">https://ko-fi.com/nokse22</url>
  <url type="contact">https://matrix.to/#/#high-tide:matrix.org</url>
  <url type="contribute">https://github.com/Nokse22/high-tide/blob/master/CONTRIBUTING.md</url>
  <url type="help">https://matrix.to/#/#high-tide:matrix.org</url>

  <translation type="gettext">high-tide</translation>

  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </recommends>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/Nokse22/high-tide/master/data/resources/screenshot%201.png</image>
      <caption>High Tide in a large window format playing the `Song 2` by Blur</caption>
    </screenshot>

    <screenshot>
      <image>https://raw.githubusercontent.com/Nokse22/high-tide/master/data/resources/screenshot%202.png</image>
      <caption>High Tide in a large window format playing `Sultan Of Swing` by Dire Straits</caption>
    </screenshot>

    <screenshot>
      <image>https://raw.githubusercontent.com/Nokse22/high-tide/master/data/resources/screenshot%203.png</image>
      <caption>High Tide in a small window format playing `Elenore` by The Turtles and showing the queue</caption>
    </screenshot>

    <screenshot>
      <image>https://raw.githubusercontent.com/Nokse22/high-tide/master/data/resources/screenshot%204.png</image>
      <caption>High Tide in a small window format playing `Light My Fire` by The Doors</caption>
    </screenshot>
  </screenshots>

  <releases>
    <release version="1.10.0" date="2026-11-24">
      <description translate="no">
        <p>Artist pages show Compilations, Live albums, Playlists, Influencers and the albums the artist appears on, like TIDAL</p>
        <p>Queue whole albums, playlists and mixes, and add a song to the queue with one click from its row</p>
        <p>Play and Shuffle on My Tracks</p>
        <p>High Tide opens on the tab used last; Alt+1, Alt+2 and Alt+3 switch tabs, and typing on Explore searches</p>
        <p>Song and artist cards get a menu, like album and playlist cards</p>
        <p>The My Tracks card TIDAL puts on Home shows up</p>
        <p>The repeat button lights up while repeat is on, with one loop icon and a 1 for repeat one</p>
        <p>Convert songs to one sample rate, to stop the pop some sound cards make between songs</p>
        <p>The volume slider shows the volume of the DLNA or Cast device playing</p>
        <p>Fix picking a DLNA or Cast device setting it to full volume, and Kodi being taken for another app</p>
      </description>
    </release>
    <release version="1.9.0" date="2026-11-23">
      <description translate="no">
        <p>Log in by scanning a QR code with your phone</p>
        <p>Keep playing similar songs when the music ends, with Autoplay similar songs in Preferences</p>
        <p>The queue opens in a panel next to the player and shows the playing song; songs in it can be removed, moved and cleared</p>
        <p>Search in album, playlist and mix pages, and in every list of your Collection</p>
        <p>Sort the lists of your Collection</p>
        <p>Keep playlists in folders</p>
        <p>Playlist and folder options on their cards, and the song menu on a right click or long press</p>
        <p>See what the playing song is played from, and open its menu from the player</p>
        <p>"Because you listened to" rows show the album they're about</p>
        <p>Search your playlists in Add to a playlist; playlists made in other apps show up there and in your Collection</p>
        <p>A notice when TIDAL sends a song in lower quality than chosen</p>
        <p>Fix the wrong song or album coming back after a restart</p>
        <p>Fix lyrics opening where the previous song's were scrolled to</p>
        <p>Fix pages piling up when going back and forth between them</p>
      </description>
    </release>
    <release version="1.8.0" date="2026-11-22">
      <description translate="no">
        <p>Play on DLNA and Chromecast devices, like speakers, TVs and streamers</p>
        <p>Show the artist's name in the Discord status</p>
        <p>Start faster: the home page no longer waits for your favourites to load</p>
        <p>The Collection page updates when you add or remove something, and still shows the rest if one part fails to load</p>
        <p>Show an album cover for artists without a picture</p>
        <p>Add tooltips to icon buttons</p>
        <p>Wait a moment before opening the volume slider on hover</p>
        <p>Fix seeking into the last seconds of a song skipping to the next one</p>
        <p>Fix the next song being skipped, or playback stopping, when it fails to load</p>
        <p>Fix skipped songs playing one after another once they finish loading</p>
        <p>Fix a reloaded song sometimes starting over</p>
        <p>Fix Raise and Quit in the media controls</p>
        <p>Fix headers and song rows being cut off with larger text</p>
        <p>Fix a page opening a second time when you click a link to it while it's open</p>
        <p>Fix the same song downloading several times, and High Tide staying open after closing it</p>
      </description>
    </release>
    <release version="1.7.0" date="2026-11-13">
      <description translate="no">
        <p>Scrobble to Last.fm and ListenBrainz</p>
        <p>Report plays to TIDAL, so songs show up in Recently played and count toward your recommendations</p>
        <p>Label AI-generated music, with an option to hide it</p>
        <p>Click a song in the queue to play it</p>
        <p>Open the volume slider by hovering over it, and set the volume in 1% steps</p>
        <p>Open the album from the song title in the player</p>
        <p>Right-click song cards for the track menu; the song top hit opens its album</p>
        <p>Show an error page with Try Again instead of loading forever</p>
        <p>Fix Discord Rich Presence</p>
        <p>Fix Next restarting the song with repeat one, and shuffle off replaying songs</p>
        <p>Fix TIDAL playlist and mix links</p>
        <p>Let other apps use the sound card while paused with the ALSA output</p>
        <p>Remove the PipeWire output option, which could cause crackling; the default output uses PipeWire</p>
      </description>
    </release>
    <release version="1.6.0" date="2026-11-10">
      <description translate="no">
        <p>Block artists and tracks</p>
        <p>Create, edit and delete playlists, and remove tracks from them</p>
        <p>Add album info and track credits pages</p>
        <p>Add a My Activity page with your most played artists of each month</p>
        <p>Add play buttons to cards and highlight the playing track with the accent color</p>
        <p>Show explicit, Dolby Atmos and quality badges on albums</p>
        <p>Add an option to prefer clean album versions</p>
        <p>Show your whole collection in See all, not just the first 1000 items</p>
        <p>Sort favorites by recently added</p>
        <p>Keep the computer awake while music plays</p>
        <p>Fix playback stalling after a long pause or sleep, albums stopping midway, and repeat on the last track</p>
        <p>Fix saved tracks not playing offline and silent gaps in saved tracks</p>
        <p>Fix the wrong song showing after switching albums</p>
        <p>Fix freezes when a track has no lyrics, when started from a terminal, or with Discord running</p>
        <p>Fix crashes on startup without a sound card, and show a clear message when no password store is available</p>
        <p>Fix artist pages listing every version of an album</p>
        <p>Fix the top hit play and shuffle buttons</p>
        <p>Fix media controls showing only the first artist and flickering play/pause</p>
      </description>
    </release>
    <release version="1.5.0" date="2026-06-24">
      <description translate="no">
        <p>Clarify that the "Page not found" redirect is expected</p>
        <p>Fix deduplicate artist top tracks</p>
        <p>Fix playback stuck when pipewire active</p>
      </description>
    </release>
    <release version="1.4.0" date="2026-05-16">
      <description translate="no">
        <p>Add music cache support</p>
        <p>Switch login to PKCE flow for FLAC/HiRes streams</p>
        <p>Add playback indicator</p>
        <p>Enable touch gestures for carousel</p>
        <p>Fix seek on pause</p>
        <p>Fix Discord RPC crash and clear status on idle</p>
        <p>Fix page title stuck on Loading</p>
      </description>
    </release>
    <release version="1.3.1" date="2026-04-14">
      <description translate="no">
        <p>Added SOCKS support back</p>
      </description>
    </release>
    <release version="1.3.0" date="2026-04-13">
      <description translate="no">
        <p>Fix favourite tracks, Discord RPC style and timestamp functionality</p>
        <p>Implement seek support, shuffle, and loop controls for MPRIS interface</p>
        <p>Add a sort option to the tracks list page</p>
        <p>Add conditional fallback when GST version is lower than 1.26</p>
        <p>Remove limit of 10 visible playlists in add-to-playlist</p>
        <p>Show correct track count and duration for large playlists and albums</p>
        <p>Retry TIDAL session connection on ConnectionResetError</p>
        <p>Fix Discord RPC crash and clear status on pause</p>
        <p>Fix MPRIS bugs</p>
        <p>Get rid of the incompatible ShortcutList items</p>
        <p>Update German translation</p>
        <p>Add .envrc for Nix direnv</p>
        <p>Update python3-pypresence.json</p>
      </description>
    </release>
    <release version="1.2.0" date="2026-01-19">
      <description translate="no">
        <p>Port to Adw.ShortcutsDialog</p>
        <p>Fix track widget image size</p>
        <p>Update runtime and dependencies</p>
        <p>Skip unavailable tracks</p>
        <p>Fix favorite playlists pagination</p>
      </description>
    </release>
    <release version="1.1.0" date="2025-08-25">
      <description translate="no">
        <p>ALSA device setting for exclusive hardware access</p>
        <p>Spanish translation</p>
        <p>Translation fixes</p>
        <p>Bug fixes</p>
      </description>
    </release>
    <release version="1.0.0" date="2025-08-20">
      <description translate="no">
        <p>Improve app responsiveness</p>
        <p>Apply Track replay gain if album gain is missing</p>
        <p>Add fallback replay gain</p>
        <p>Gapless playback</p>
        <p>Add support for home page shortcuts</p>
        <p>Bug fixes</p>
      </description>
    </release>
    <release version="0.1.8" date="2025-08-01">
      <description translate="no">
        <p>Add Pipewire sink</p>
        <p>Fix video cover setting not applied on startup</p>
        <p>Add german-german translation</p>
        <p>Add settings toggle for rich presence</p>
        <p>Add Brazilian Portuguese translation</p>
        <p>Implement keyring unlocking</p>
        <p>Fix video covers not being paused when started in background</p>
        <p>Disconnect discord RPC when idle for 5 minutes</p>
        <p>Added SOCKS proxy support</p>
        <p>Fix track not showing past first 100</p>
      </description>
    </release>
    <release version="0.1.7" date="2025-06-14">
      <description translate="no">
        <p>Add Discord rich presence</p>
        <p>Add album duration in album page</p>
        <p>Changed App ID</p>
        <p>Added animated covers</p>
        <p>Improved used covers quality</p>
        <p>Ensure volume is synced</p>
        <p>Improve preferences window</p>
        <p>Made unavailable track unsensitive</p>
      </description>
    </release>
    <release version="0.1.6" date="2025-06-03">
      <description translate="no">
        <p>Use full_name of track if available</p>
        <p>Swiss German translation</p>
        <p>French translation</p>
        <p>Dutch translation</p>
        <p>Allow Turntable support</p>
        <p>Add Discord Rich Presence integration</p>
        <p>Improved flatpak permissions</p>
      </description>
    </release>
    <release version="0.1.5" date="2025-05-30">
      <description translate="no">
        <p>First public release! 🎉</p>
      </description>
    </release>
  </releases>

  <categories>
    <category>Audio</category>
    <category>Music</category>
  </categories>

</component>
